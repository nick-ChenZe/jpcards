{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "jpcards",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-24",
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "directory": "../frontend/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
    },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "jpcards",
            "database_id": "5b998b68-97d1-4710-8d46-556c8f4c7a70",
            "migrations_dir": "migrations"
        }
    ]
    // ADMIN_EMAILS 是 Worker secret，不要写进这个文件，也不要写进 vars。
    // 不设置时全量卡片关闭。生产先不要写入，等名单和审计拍板后再 wrangler secret put。
}

{
    "name": "@jpcards/backend",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "start": "nodemon -e ts --exec \"node --loader ts-node/esm index.ts\"",
        "test": "vitest run",
        "eval:image": "node scripts/eval-qwen-image.mjs",
        "dev": "node scripts/stage-kuromoji.mjs && wrangler dev --port 8787",
        "deploy": "node scripts/stage-kuromoji.mjs && wrangler deploy",
        "db:migrate:local": "wrangler d1 migrations apply jpcards --local",
        "db:migrate:remote": "wrangler d1 migrations apply jpcards --remote",
        "build": "rm -rf dist/ && pnpm run prepare:assets && tsc",
        "db:push": "drizzle-kit push",
        "db:generate": "drizzle-kit generate",
        "db:studio": "drizzle-kit studio",
        "prepare:assets": "node scripts/stage-kuromoji.mjs"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.989.0",
        "@jpcards/shared": "workspace:^",
        "axios": "^1.12.2",
        "better-auth": "^1.3.25",
        "drizzle-orm": "^0.45.1",
        "gpt-tokenizer": "^3.0.1",
        "hono": "^4.11.9",
        "kuromoji": "^0.1.2",
        "openai": "^5.23.1",
        "wanakana": "^5.3.1",
        "wrangler": "^4.65.0"
    },
    "devDependencies": {
        "@types/node": "^24.5.2",
        "drizzle-kit": "^0.31.9",
        "nodemon": "^3.1.10",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.2",
        "vitest": "^3.2.4"
    }
}

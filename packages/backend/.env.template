BETTER_AUTH_SECRET=

# 不填时，Worker 使用当前请求的 origin。
# 本地 wrangler 一般是 http://localhost:8787
BETTER_AUTH_URL=

# 逗号分隔。本地前端开发端口只在 localhost 请求里自动信任。
BETTER_AUTH_TRUSTED_ORIGINS=

# 文本模型。两个都填写才会生卡；缺任何一个都不会请求 DeepSeek。
CHAT_API_KEY=
CHAT_API_ENDPOINT=
CHAT_MODEL=

# 配图。不填时：两个百炼变量都空就是 noop；有任意一个则走正式模型 qwen-image-3.0。
# 只放在本机 .dev.vars 或 Worker secret，不要写进仓库。
# seedream / openai 必须写进 IMAGE_PROVIDER，不会因为密钥存在就成为默认。
# 当前都不会真正发请求。接入时按大约 20 RPM 排队，不要假设更高并发。
# QWEN_IMAGE_TIER=turbo 只用于预览 qwen-image-2.1-turbo，评测通过前不能当默认。
IMAGE_PROVIDER=
QWEN_IMAGE_TIER=
DASHSCOPE_API_KEY=
BAILIAN_API_KEY=
# 上面两个密钥有任意一个时，卡片语音会请求 qwen3-tts-flash（Japanese）。都空则不请求。
# 仅 IMAGE_PROVIDER=seedream，模型 5.0-flash
SEEDREAM_API_KEY=
# 仅 IMAGE_PROVIDER=openai。只放官方 API key，不要放 Codex / ChatGPT OAuth。
OPENAI_API_KEY=

# 下面这些只给本机 drizzle-kit 或旧的集成测试，不要放进 Worker secret。
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
D1_DATABASE_ID=

# 火山生图和 MiniMax 语音不是当前请求路径。留空。
VOLC_API_AK=
VOLC_API_SK=
MINIMAX_ENDPOINT=
MINIMAX_API_KEY=
MINIMAX_MODEL=
MINIMAX_VOICE_ID=

# 旧的 S3 兼容测试。Worker 生图不再走这里。
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_PUBLIC_URL=

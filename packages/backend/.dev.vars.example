# 复制为 packages/backend/.dev.vars。不要提交真实密钥。
# 本地：wrangler dev 会读取 .dev.vars。
# 生产：用 `wrangler secret put` 写入，不要写进 wrangler.jsonc。

BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:8787

# 管理员邮箱，英文逗号分隔。只有这些登录用户能打开 /admin/cards。
# 下面是格式示例，不要把真实邮箱提交进仓库。
# 留空或不写这一行时角色闸关闭，没有任何管理员。
# 生产先不要设置。名单和审计等拍板后，再用 wrangler secret put ADMIN_EMAILS。
# ADMIN_EMAILS=you@example.com,editor@example.com

# 文本模型。留空则生卡关闭，不会请求 DeepSeek。
# CHAT_API_KEY=
# CHAT_API_ENDPOINT=
# CHAT_MODEL=

# 配图。不填 IMAGE_PROVIDER 时，没有百炼密钥就是 noop，不会发请求。
# 有 DASHSCOPE_API_KEY 或 BAILIAN_API_KEY 才会选通义，正式模型是 qwen-image-3.0，并请求百炼同步生图。
# 同一个密钥也会打开日语语音 qwen3-tts-flash。没有密钥时语音不会发请求。
# QWEN_IMAGE_TIER=turbo 只用于预览 qwen-image-2.1-turbo，评测通过前不要当默认。
# Seedream / OpenAI 必须显式选择。不要填真实密钥，也不要填 Codex / ChatGPT OAuth。
# IMAGE_PROVIDER=noop
# DASHSCOPE_API_KEY=
# BAILIAN_API_KEY=
# SEEDREAM_API_KEY=
# OPENAI_API_KEY=
